# ======================== 域名与网络配置 ========================
DOMAIN=localhost

FRONTEND_HOST=http://localhost:3000

ENVIRONMENT=local

PROJECT_NAME="MY FIRST FULL STACK TEMPLATE"

# ======================== 后端应用配置 ========================
# CORS 跨域：本地开发允许所有来源访问（生产环境请收窄为具体域名）
CORS_ALLOW_ORIGINS=["*"]

API_V1_STR="/v1"

# ⚠️ 生产环境必须改成强随机字符串（至少 32 位）
SECRET_KEY="09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7"

FIRST_SUPERUSER=admin@example.com
# ⚠️ 生产环境必须改成强密码
FIRST_SUPERUSER_PASSWORD=admin123

# ======================== SQLite 数据库配置 ========================
# 使用本地 SQLite 文件库（无需外部数据库服务器）
# 路径相对 apps/api 目录，可改为绝对路径，如 /home/daria/my_fullstack_tamplelate/apps/api/app.db
DATABASE_URL=sqlite+aiosqlite:///./app.db

# PostgreSQL 配置（可选：仅在未设置 DATABASE_URL 时生效）
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=my_fullstack
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres123

# ======================== 其他配置 ========================
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30000

DEBUG=True

# Sentry（可选）
SENTRY_DSN=