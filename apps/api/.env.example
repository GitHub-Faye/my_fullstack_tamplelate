# ======================== 域名与网络配置 ========================
DOMAIN=localhost

FRONTEND_HOST=http://localhost:5173

ENVIRONMENT=local

PROJECT_NAME="MY FIRST FULL STACK TEMPLATE"

# ======================== 后端应用配置 ========================
CORS_ALLOW_ORIGINS=["http://localhost.tiangolo.com","https://localhost.tiangolo.com","http://localhost","http://localhost:8080"]

API_V1_STR="/v1"

# ⚠️ 生产环境必须改成强随机字符串（至少 32 位）
SECRET_KEY="09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7"

FIRST_SUPERUSER=admin@example.com
# ⚠️ 生产环境必须改成强密码
FIRST_SUPERUSER_PASSWORD=changethis

# ======================== 邮件服务（SMTP）配置 ========================
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# ======================== PostgreSQL 数据库配置 ========================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=my_fullstack
POSTGRES_USER=postgres
# ⚠️ 生产环境必须改成强密码
POSTGRES_PASSWORD=postgres123
# ======================== 应用连接字符串 ========================
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# ======================== Redis 配置 ========================
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# ======================== RabbitMQ 配置（新增/重点修改） ========================
# RabbitMQ 默认用户和密码（生产环境强烈建议修改成强密码）
RABBITMQ_DEFAULT_USER=celery_user
RABBITMQ_DEFAULT_PASS=celery123          # ← 生产请改成强密码！

# RabbitMQ 虚拟主机（推荐使用独立 vhost，逻辑隔离）
RABBITMQ_DEFAULT_VHOST=celery_vhost


# Redis 连接（容器内使用 service name）
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:${REDIS_PORT}/0

# ======================== Celery 配置（已切换为 RabbitMQ Broker） ========================
# Broker 使用 RabbitMQ（生产推荐）
CELERY_BROKER_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@localhost:5672/${RABBITMQ_DEFAULT_VHOST}

# Backend 继续使用 Redis（速度快，适合存任务结果）
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@localhost:${REDIS_PORT}/1

# 可选：如果想在某些环境仍用 Redis 做 Broker，可以这样写（但不推荐生产）
# CELERY_BROKER_URL=${REDIS_URL}

# ======================== 其他配置 ========================
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

DEBUG=True

# Sentry（可选）
SENTRY_DSN=


